# APS Application Credentials (from https://aps.autodesk.com/myapps)
APS_CLIENT_ID="your-client-id-here"
APS_CLIENT_SECRET="your-client-secret-here"

# Service Account (SSA) Credentials
SSA_ID="your-ssa-id"
SSA_KEY_ID="your-ssa-key-uuid"
SSA_KEY_PATH="/absolute/path/to/your-key.pem"

# ACC Configuration
# Account ID: find in ACC Admin > Account Settings, or via the getProjects MCP tool
ACC_ACCOUNT_ID="your-acc-account-uuid"
# Region: AUS, US, or EMEA
ACC_REGION="AUS"
# ADS Region header: APAC, US, or EMEA
ACC_ADS_REGION="APAC"

# Cost Management (optional — agent can resolve from project ID via getCostContainerTool)
ACC_COST_CONTAINER_ID=""
